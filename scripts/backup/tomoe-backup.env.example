# tomoe-backup configuration
#
# Copy this file to $XDG_CONFIG_HOME/tomoe/backup.env
# (or set $TOMOE_BACKUP_CONFIG to point at any path) and edit the values below.
#
# The script is a plain Bash source; standard shell quoting rules apply.

# ---- Required --------------------------------------------------------------

# SSH user on the backup host.
REMOTE_USER="your-user"

# Backup hostname (must reachable via SSH key auth from wherever cron runs).
REMOTE_HOST="backup.example.com"

# Absolute destination path on the backup host. Created by rsync if it does
# not yet exist and the SSH user has permission.
REMOTE_DIR="/srv/backups/tomoe-sessions"

# ---- Optional --------------------------------------------------------------

# Local sessions directory. Default: $HOME/.local/share/tomoe/sessions
# SESSIONS_DIR="$HOME/.local/share/tomoe/sessions"

# Audio files older than this many days are pruned locally after they've been
# verified to exist on the remote with a matching byte size. Default: 7
# AUDIO_RETENTION_DAYS=7

# Explicit SSH private key. Leave unset to let ssh pick the default (id_ed25519,
# id_rsa, …). Useful when cron needs a non-default key.
# SSH_KEY="$HOME/.ssh/id_ed25519_backup"

# Where the run log lives.
# Default: ${XDG_STATE_HOME:-$HOME/.local/state}/tomoe-backup
# LOG_DIR="$HOME/.local/state/tomoe-backup"

# Single-instance lock. Default: /tmp/tomoe-backup.lock
# LOCK_FILE="/tmp/tomoe-backup.lock"

# Log rotation thresholds.
# LOG_MAX_BYTES=5242880    # 5 MiB
# LOG_ROTATE_KEEP=5
